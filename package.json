{
  "name": "billing-subscription-aggregator",
  "version": "1.0.0",
  "description": "Unified billing and subscription management backend",
  "private": true,
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "cd backend && npm run dev",
    "dev:admin": "cd admin-ui && npm run dev",
    "build": "npm run build:backend && npm run build:admin",
    "build:backend": "cd backend && npm run build",
    "build:admin": "cd admin-ui && npm run build",
    "start": "npm run start:backend",
    "start:backend": "cd backend && npm run start:prod",
    "start:admin": "cd admin-ui && npm start",
    "test": "cd backend && npm test",
    "lint": "npm run lint:backend && npm run lint:admin",
    "lint:backend": "cd backend && npm run lint",
    "lint:admin": "cd admin-ui && npm run lint",
    "db:generate": "cd backend && npm run db:generate",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:push": "cd backend && npm run db:push",
    "db:seed": "cd backend && npm run db:seed",
    "db:studio": "cd backend && npm run db:studio",
    "db:reset": "cd backend && npm run db:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:db": "docker compose up -d postgres",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "setup": "npm run install:all && npm run db:generate",
    "install:all": "npm install && cd backend && npm install && cd ../admin-ui && npm install"
  },
  "keywords": [
    "billing",
    "subscription",
    "stripe",
    "paypal",
    "nestjs",
    "nextjs"
  ],
  "author": "",
  "license": "MIT"
}
